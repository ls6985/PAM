<ui:FluentWindow
    x:Class="PAM.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:PAM.App.Controls"
    xmlns:models="clr-namespace:PAM.Core.Models;assembly=PAM.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PowerShell 别名管理器"
    Width="1160"
    Height="780"
    MinWidth="940"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="PowerShell 别名管理器"
            Icon="{ui:SymbolIcon Code24}" />

        <Grid Grid.Row="1" Margin="28,8,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页头 -->
            <Grid Grid.Row="0" Margin="0,4,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="别名管理" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="在 $PROFILE 中集中管理 Set-Alias 快捷启动项，保存后立即在新窗口生效。"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    MaxWidth="420"
                    Padding="12,8"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="DocumentText24"
                            VerticalAlignment="Center" />
                        <controls:MiddleEllipsisTextBlock
                            x:Name="ProfilePathText"
                            Width="340"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ProfilePath}"
                            ToolTip="{Binding ProfilePath}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 工具栏 -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    x:Name="SearchBox"
                    Width="380"
                    HorizontalAlignment="Left"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="搜索别名、路径或备注"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        x:Name="AddButton"
                        Click="AddButton_Click"
                        Content="新建别名"
                        Icon="{ui:SymbolIcon Add24}"
                        IsEnabled="False" />
                    <ui:Button
                        x:Name="SaveButton"
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Click="SaveButton_Click"
                        Content="保存并生效"
                        Icon="{ui:SymbolIcon Save24}"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>

            <!-- 内联编辑条：新建 / 编辑共用，不使用弹窗 -->
            <Border
                x:Name="EditorPanel"
                Grid.Row="2"
                Margin="0,0,0,14"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Edit24"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="EditorTitleText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding EditorTitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Enter 确定 · Esc 取消"
                            Style="{StaticResource TertiaryTextStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="别名（必填）" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox
                                x:Name="AliasField"
                                IsEnabled="{Binding IsAliasFieldEnabled}"
                                PlaceholderText="例如 blbl"
                                Text="{Binding EditorAlias, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="应用程序路径（必填）" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    x:Name="PathField"
                                    PlaceholderText="C:\Program Files\App\app.exe"
                                    Text="{Binding EditorPath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    x:Name="BrowseButton"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="BrowseButton_Click"
                                    Content="浏览…"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabelStyle}" />
                            <ui:TextBox
                                x:Name="RemarkField"
                                PlaceholderText="例如：打开哔哩哔哩"
                                Text="{Binding EditorRemark, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="6"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <ui:Button
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Content="取消" />
                            <ui:Button
                                x:Name="ConfirmButton"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Click="ConfirmButton_Click"
                                Content="确定"
                                Icon="{ui:SymbolIcon Checkmark24}"
                                IsEnabled="{Binding IsConfirmEnabled}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock
                            x:Name="EditorErrorText"
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding EditorErrorText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding EditorErrorVisibility}" />
                        <TextBlock
                            x:Name="EditorPathHintText"
                            Margin="12,0,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding EditorPathHintText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding EditorPathHintVisibility}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 列标题 -->
            <Border
                Grid.Row="3"
                Margin="0,0,0,4"
                Padding="16,8"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="别名" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="路径" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock Grid.Column="2" Text="备注" Style="{StaticResource ColumnHeaderTextStyle}" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        Text="操作"
                        Style="{StaticResource ColumnHeaderTextStyle}" />
                </Grid>
            </Border>

            <!-- 别名列表 -->
            <Grid Grid.Row="4">
                <ui:ListView
                    x:Name="AliasList"
                    ItemsSource="{Binding Aliases}"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource AliasListItemStyle}"
                    MouseDoubleClick="AliasList_MouseDoubleClick"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Single">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AliasEntry}">
                            <Grid Height="46" Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Text="{Binding Name}"
                                    ToolTip="{Binding Name}"
                                    Style="{StaticResource AliasNameTextStyle}" />

                                <Grid Grid.Column="1" Margin="0,0,16,0" ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        FontSize="15"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Symbol="Warning24"
                                        ToolTip="文件不存在"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding PathMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <controls:MiddleEllipsisTextBlock
                                        Grid.Column="1"
                                        AutomationProperties.Name="{Binding Path}"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Path}"
                                        ToolTip="{Binding Path}"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,16,0"
                                    Text="{Binding Remark}"
                                    ToolTip="{Binding Remark}"
                                    Style="{StaticResource RemarkTextStyle}" />

                                <Grid
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowActionPanelStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            AutomationProperties.Name="编辑"
                                            Click="EditButton_Click"
                                            Style="{StaticResource RowIconButtonStyle}"
                                            ToolTip="编辑">
                                            <ui:SymbolIcon FontSize="15" Symbol="Edit24" />
                                        </ui:Button>
                                        <ui:Button
                                            AutomationProperties.Name="删除"
                                            Margin="2,0,0,0"
                                            Click="DeleteButton_Click"
                                            Style="{StaticResource RowIconButtonStyle}"
                                            ToolTip="删除（再次点击确认）">
                                            <Grid>
                                                <ui:SymbolIcon
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Symbol="Delete24"
                                                    Visibility="{Binding IsDeleteIdle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Text="确认删除？"
                                                    Visibility="{Binding DeletePending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="38"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="Apps24" />
                    <TextBlock x:Name="EmptyTitleText" Style="{StaticResource EmptyTitleStyle}" />
                    <TextBlock x:Name="EmptyDescriptionText" Style="{StaticResource EmptyDescriptionStyle}" />
                </StackPanel>
            </Grid>

            <!-- 状态栏 -->
            <Border
                Grid.Row="5"
                Margin="0,14,0,0"
                Padding="12,8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            x:Name="StatusIcon"
                            Margin="0,0,8,0"
                            FontSize="16"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="Info24" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding StatusMessage}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="PolicyWarningPanel"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <ui:SymbolIcon
                            Margin="0,0,6,0"
                            FontSize="15"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Symbol="Warning24" />
                        <TextBlock
                            x:Name="PolicyWarningText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="执行策略受限" />
                        <ui:Button
                            x:Name="FixPolicyButton"
                            Height="28"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Appearance="Secondary"
                            Click="FixPolicyButton_Click"
                            Content="尝试修复" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
