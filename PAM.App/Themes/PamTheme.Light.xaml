<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PAM 浅色主题画刷：覆盖 WPF-UI 主题字典里的同名键。
        WPF-UI 的强调色跟随系统强调色，系统可能配成接近黑的深色，主按钮与开关会显得沉重；
        这里统一改用标准 WinUI 蓝。键名分两层：AccentFillColor* 是基础色板，
        AccentButtonBackground / ToggleSwitchFillOn 等是各控件模板直接引用的成品画刷，两层都要覆盖。
        本文件与 PamTheme.Dark.xaml 由 ThemeService 在主题变化时整体替换。
    -->

    <!-- 基础强调色板 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E5005FB8" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#80005FB8" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#80005FB8" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#003E75" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#99005FB8" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#005FB8" />

    <!-- 主按钮（Appearance=Primary） -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E5005FB8" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC005FB8" />

    <!-- 开关：开启态用强调色，关闭态为浅灰轨道 -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#005FB8" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E5005FB8" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#CC005FB8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#005FB8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#E5005FB8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#CC005FB8" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#14000000" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#29000000" />

    <!-- 勾选 / 单选 / 折叠开关的选中态 -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#005FB8" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E5005FB8" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#CC005FB8" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#005FB8" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#CC005FB8" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#005FB8" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#CC005FB8" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#005FB8" />

    <!-- 输入框焦点描边 -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#005FB8" />

    <!-- 进度、滑块、链接、列表选中胶囊 -->
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#005FB8" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#005FB8" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E5005FB8" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#005FB8" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#003E75" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#003E75" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="BadgeBackground" Color="#005FB8" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#005FB8" />

    <!--
        按钮 / 输入框 / 卡片的描边：WPF-UI 默认用渐变描边（ControlElevationBorderBrush /
        TextControlElevationBorderBrush / AccentControlElevationBorderBrush），边缘偏深偏硬；
        统一换成半透明细线，与 ControlStrokeColorDefaultBrush 同值。
    -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#26000000" />

    <!-- 顶部导航页签选中态：浅强调底 + 深色文字 -->
    <SolidColorBrush x:Key="NavTabSelectedBackgroundBrush" Color="#1F005FB8" />
    <SolidColorBrush x:Key="NavTabSelectedBorderBrush" Color="#73005FB8" />

    <!-- 底部状态栏：低透明度信息蓝，替换原来偏亮的白色填充层 -->
    <SolidColorBrush x:Key="PamStatusBarBackgroundBrush" Color="#0D005FB8" />
    <SolidColorBrush x:Key="PamStatusBarBorderBrush" Color="#1F005FB8" />
</ResourceDictionary>
