<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PAM 深色主题画刷：与 PamTheme.Light.xaml 键名一一对应，值按深色背景重新取。
        强调色取 WinUI 深色主题的标准亮蓝：深色底上更清晰，配 TextOnAccentFillColorPrimaryBrush
        的深色文字（WPF-UI 深色主题下该键为黑色）。
    -->

    <!-- 基础强调色板 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E560CDFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8060CDFF" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#8060CDFF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#99EBFF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#60CDFF" />

    <!-- 主按钮（Appearance=Primary） -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E560CDFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC60CDFF" />

    <!-- 开关：开启态用强调色，关闭态为浅灰轨道 -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#60CDFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E560CDFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#60CDFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#E560CDFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3DFFFFFF" />

    <!-- 勾选 / 单选 / 折叠开关的选中态 -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#60CDFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E560CDFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#60CDFF" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#60CDFF" />

    <!-- 输入框焦点描边 -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#60CDFF" />

    <!-- 进度、滑块、链接、列表选中胶囊 -->
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#60CDFF" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#60CDFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E560CDFF" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#60CDFF" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#99EBFF" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#99EBFF" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="BadgeBackground" Color="#60CDFF" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#60CDFF" />

    <!-- 按钮 / 输入框 / 卡片的描边：与浅色同结构，换成深色下的半透明白线 -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#26000000" />

    <!-- 顶部导航页签选中态：低透明度强调底 + 强调色描边 -->
    <SolidColorBrush x:Key="NavTabSelectedBackgroundBrush" Color="#2E60CDFF" />
    <SolidColorBrush x:Key="NavTabSelectedBorderBrush" Color="#8C60CDFF" />

    <!-- 底部状态栏：低透明度信息蓝，替换原来的深灰填充层 -->
    <SolidColorBrush x:Key="PamStatusBarBackgroundBrush" Color="#1460CDFF" />
    <SolidColorBrush x:Key="PamStatusBarBorderBrush" Color="#1F60CDFF" />
</ResourceDictionary>
