<UserControl
    x:Class="PAM.App.Views.BeautifyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:PAM.App"
    xmlns:vm="clr-namespace:PAM.App.ViewModels"
    xmlns:local="clr-namespace:PAM.App.Views"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 片段内容：收起显示短名，展开显示分类·名称 -->
        <DataTemplate x:Key="SegmentShortTemplate">
            <TextBlock FontSize="12" Text="{Binding ShortName}" />
        </DataTemplate>
        <DataTemplate x:Key="SegmentFullTemplate">
            <TextBlock FontSize="12" Text="{Binding DisplayName}" />
        </DataTemplate>

        <local:SegmentChoiceTemplateSelector
            x:Key="SegmentChoiceTemplateSelector"
            FullTemplate="{StaticResource SegmentFullTemplate}"
            ShortTemplate="{StaticResource SegmentShortTemplate}" />
        <local:CustomSelectedToVisibilityConverter x:Key="CustomSelectedToVisibility" />

        <!-- 颜色项模板：预设显示色块 + 色号，自定义显示「自定义…」 -->
        <DataTemplate x:Key="ColorSwatchTemplate">
            <StackPanel Orientation="Horizontal">
                <Rectangle
                    Width="13"
                    Height="13"
                    VerticalAlignment="Center"
                    Fill="{Binding Brush}"
                    RadiusX="3"
                    RadiusY="3" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MonoFontFamily}"
                    FontSize="12"
                    Text="{Binding Hex}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ColorCustomTemplate">
            <TextBlock FontSize="12" Text="{loc:Loc '自定义…'}" />
        </DataTemplate>

        <local:ColorChoiceTemplateSelector
            x:Key="ColorChoiceTemplateSelector"
            CustomTemplate="{StaticResource ColorCustomTemplate}"
            SwatchTemplate="{StaticResource ColorSwatchTemplate}" />
        <local:ColorCustomToVisibilityConverter x:Key="ColorCustomToVisibility" />

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 高级选项开关：透明模板保留整行点击区域，IsChecked 默认 false 即收起。 -->
        <Style x:Key="AdvancedToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题卡内的从属子卡：与外层卡片用底色和边框区分层级。 -->
        <Style x:Key="SubCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SubCardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- 外观区域的分组标题：显示效果 / 光标 / 背景图 / 窗口 -->
        <Style x:Key="AppearanceGroupTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <ScrollViewer
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 页头：标题 + 手动刷新（进入页签不再自动探测，避免切换卡顿） -->
                <Grid Margin="0,4,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc '美化'}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{loc:Loc '设置终端字体、外观和命令行提示符。第一次修改前会自动备份，随时可以还原；点「刷新状态」重新检测。'}"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <ui:Button
                            Appearance="Secondary"
                            Click="RefreshButton_Click"
                            Content="{loc:Loc '刷新状态'}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            IsEnabled="{Binding CanRefresh}"
                            ToolTip="{loc:Loc '重新探测 Starship、Scoop、字体与终端配置状态。'}" />
                        <Border
                            Margin="8,0,0,0"
                            Style="{StaticResource PageTagBorderStyle}"
                            ToolTip="{loc:Loc '保存时只重写该区块，区块外的 $PROFILE 内容不会被修改。'}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    FontSize="16"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="Code24"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Style="{StaticResource PageTagTextStyle}"
                                    Text="PAM-Theme" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Starship -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Starship" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        FontSize="14"
                                        Margin="0,0,6,0"
                                        Symbol="Rocket24"
                                        VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StarshipStatusText}" Style="{StaticResource SettingLabelStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:SymbolIcon
                                        FontSize="14"
                                        Margin="0,0,6,0"
                                        Symbol="Toolbox24"
                                        VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ScoopStatusText}" Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Text="{loc:Loc 'Starship 用来美化命令行提示符；装好后就能用，不用手动配置。'}"
                                    Style="{StaticResource SettingHintStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{loc:Loc '建议先装好图标字体，否则主题里的符号可能显示成方块。'}"
                                    Visibility="{Binding HasFontSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{loc:Loc '已经装好了；换字体后重新打开终端生效。'}"
                                    Visibility="{Binding IsStarshipInstalled, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="InstallBundledFontButton_Click"
                                    Content="{loc:Loc '安装内置NF字体'}"
                                    Icon="{ui:SymbolIcon FontIncrease24}"
                                    IsEnabled="{Binding CanInstallBundledFont}"
                                    ToolTip="{loc:Loc '把打包的 Cascadia Code NF 安装为当前用户字体（免管理员权限）。'}" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Click="OneClickInstallButton_Click"
                                    Content="{loc:Loc '一键安装（含 Scoop）'}"
                                    Icon="{ui:SymbolIcon Wand24}"
                                    IsEnabled="{Binding CanOneClickInstall}"
                                    ToolTip="{loc:Loc '未选字体或已安装时不可用。'}" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="RefreshButton_Click"
                                    Content="{loc:Loc '重新检测'}"
                                    Icon="{ui:SymbolIcon ArrowSync24}"
                                    IsEnabled="{Binding CanRefresh}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 主题 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc '主题'}" Style="{StaticResource CardTitleStyle}" />
                        <!-- 当前生效的提示符方案：与上方 Starship 状态文字同亮度。 -->
                        <TextBlock
                            Margin="0,14,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding PresetStatusText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource SettingHintStyle}"
                            Text="{loc:Loc '两种方案二选一，切换后点下方的「保存设置」生效。'}" />
                        <!-- 提示符方案：二选一，切换后由下方统一按钮提交。 -->
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <RadioButton
                                Content="{loc:Loc '主题预设'}"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                GroupName="PresetScheme"
                                IsChecked="{Binding UsePresetScheme, Mode=TwoWay}"
                                VerticalContentAlignment="Center" />
                            <RadioButton
                                Margin="20,0,0,0"
                                Content="{loc:Loc '自定义提示符'}"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                GroupName="CustomScheme"
                                IsChecked="{Binding UseCustomPrompt, Mode=TwoWay}"
                                VerticalContentAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0" Visibility="{Binding UseCustomPrompt, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc '主题预设'}" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{loc:Loc '标了「需 Nerd Font」的主题要先装好字体，否则符号会显示成方块。'}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <ComboBox
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding PresetOptions}"
                                    SelectedValue="{Binding SelectedPresetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Id" />
                            </StackPanel>
                        </Grid>
                            <Border
                                Margin="0,14,0,0"
                                Padding="0,12,0,0"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Visibility="{Binding UseCustomPrompt, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{loc:Loc '自定义提示符'}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="{loc:Loc '点「添加片段」从左到右拼出提示符：每段用下拉选内容（用户名、目录、符号等）和颜色。下面的预览会实时更新；应用后只改提示符这一行，其它设置不动。'}"
                                        Style="{StaticResource SettingHintStyle}" />

                                    <!-- 实时预览（深色底模拟终端） -->
                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="12,10"
                                        Background="#1E1E1E"
                                        CornerRadius="6">
                                        <ItemsControl Focusable="False" ItemsSource="{Binding PromptPreviewParts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        FontFamily="{StaticResource MonoFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{Binding Brush}"
                                                        Text="{Binding Text}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Text="{loc:Loc '预览是示例文字，实际内容会随目录、时间等自动变化。'}"
                                        Style="{StaticResource SettingHintStyle}" />

                                    <!-- 格式：点选片段组合，不直接编辑 -->
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource SettingLabelStyle}"
                                        Text="{loc:Loc '格式'}" />

                                    <!-- 片段组合区：水平一排可选项，每个片段选内容 + 颜色，可加 / 删 -->
                                    <ItemsControl
                                        x:Name="PromptSegmentBuilder"
                                        Margin="0,8,0,0"
                                        ItemsSource="{Binding PromptSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,6,6"
                                                    Padding="6,4"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ComboBox
                                                            Width="100"
                                                            ItemsSource="{Binding Choices}"
                                                            ItemTemplateSelector="{StaticResource SegmentChoiceTemplateSelector}"
                                                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                            ToolTip="{Binding SelectedOption.ToolTipText}" />
                                                        <TextBox
                                                            Width="110"
                                                            Margin="5,0,0,0"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            FontSize="12"
                                                            Padding="4,2"
                                                            Text="{Binding CustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ToolTip="{loc:Loc '输入任意文字或 $变量'}"
                                                            Visibility="{Binding SelectedOption, Converter={StaticResource CustomSelectedToVisibility}}" />
                                                        <!-- 颜色：与变量下拉同款 ComboBox；选「自定义…」后右侧出现可编辑色号框。 -->
                                                        <ComboBox
                                                            Width="118"
                                                            Margin="5,0,0,0"
                                                            ItemsSource="{Binding ColorChoices}"
                                                            ItemTemplateSelector="{StaticResource ColorChoiceTemplateSelector}"
                                                            SelectedItem="{Binding SelectedColorOption, Mode=TwoWay}"
                                                            ToolTip="{Binding Color}" />
                                                        <TextBox
                                                            Width="66"
                                                            Margin="5,0,0,0"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            FontSize="12"
                                                            Padding="4,2"
                                                            Text="{Binding HexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ToolTip="{loc:Loc '输入 6 位十六进制色号（即 # 后面的部分）'}"
                                                            Visibility="{Binding SelectedColorOption, Converter={StaticResource ColorCustomToVisibility}}" />
                                                        <Button
                                                            MinWidth="24"
                                                            Margin="5,0,0,0"
                                                            Padding="5,2"
                                                            Click="RemoveSegmentButton_Click"
                                                            Content="×"
                                                            ToolTip="{loc:Loc '删除该片段'}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <ui:Button
                                            Appearance="Secondary"
                                            Click="AddSegmentButton_Click"
                                            Content="{loc:Loc '添加片段'}" />
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingHintStyle}"
                                            Text="{loc:Loc '下拉里能选变量和符号；颜色选预设，或选「自定义…」后填 6 位色号。'}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource SettingHintStyle}" Text="{Binding PromptStatusText}" />
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        Style="{StaticResource SettingHintStyle}"
                                        Text="{Binding PromptConfigPath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding PromptConfigPath}" />
                                </StackPanel>
                            </Border>
                        <!-- 通用选项：与高级选项同款折叠入口，默认收起。 -->
                        <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ToggleButton x:Name="CommonOptionsToggle" Style="{StaticResource AdvancedToggleStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="▸" Visibility="{Binding IsChecked, ElementName=CommonOptionsToggle, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="▾" Visibility="{Binding IsChecked, ElementName=CommonOptionsToggle, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Loc '通用设置'}" />
                                </StackPanel>
                            </ToggleButton>
                        </Border>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=CommonOptionsToggle, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc '提示符前空一行'}" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="{loc:Loc '开启后，每条命令前会多一个空行。'}" Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding PromptAddNewline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc '路径分隔符用 /'}" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="{loc:Loc '关闭后，路径分隔符跟随系统默认。'}" Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding PromptUseForwardSlash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource SettingHintStyle}"
                                Text="{loc:Loc '主题预设和自定义提示符都会用这两个设置。'}" />
                        </StackPanel>

                        <!-- 高级选项：主题卡内部，默认收起。 -->
                        <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ToggleButton x:Name="AdvancedOptionsToggle" Style="{StaticResource AdvancedToggleStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="▸" Visibility="{Binding IsChecked, ElementName=AdvancedOptionsToggle, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="▾" Visibility="{Binding IsChecked, ElementName=AdvancedOptionsToggle, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Loc '高级选项'}" />
                                </StackPanel>
                            </ToggleButton>
                        </Border>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=AdvancedOptionsToggle, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource SubCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc '外观'}" Style="{StaticResource SubCardTitleStyle}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Text="{loc:Loc '只保存改动过的项目；留空或选「终端默认」就恢复系统默认。'}"
                                        Style="{StaticResource SettingHintStyle}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SettingHintStyle}" Text="{Binding AppearanceStatusText}" />
                                    <TextBlock Margin="0,4,0,0" Text="{loc:Loc '改完后点下面的「保存设置」。'}" Style="{StaticResource SettingHintStyle}" />
                                    <!-- 字体 -->
                                    <TextBlock Margin="0,12,0,10" Text="{loc:Loc '字体'}" Style="{StaticResource AppearanceGroupTitleStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentFontText}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Text="{loc:Loc '内置图标字体已随程序打包，安装时不需要管理员权限。'}"
                                                Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ComboBox
                                                ItemsSource="{Binding FontOptions}"
                                                SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                                ToolTip="{Binding WtSettingsPath}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        Text="{loc:Loc '想用别的图标字体？装好 Scoop 后执行 scoop bucket add nerd-fonts，再安装喜欢的字体，点「刷新状态」就能在下拉里看到。'}"
                                        Style="{StaticResource SettingHintStyle}" />
                                    <!-- 显示效果 -->
                                    <TextBlock Margin="0,12,0,10" Text="{loc:Loc '显示效果'}" Style="{StaticResource AppearanceGroupTitleStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '复古风格终端显示'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock
                                                Text="{loc:Loc '模拟老式显示器的扫描线和光晕。'}"
                                                Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <CheckBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{loc:Loc '启用复古效果'}"
                                            IsChecked="{Binding RetroTerminalEffect, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- 光标 -->
                                    <TextBlock Text="{loc:Loc '光标'}" Style="{StaticResource AppearanceGroupTitleStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '光标形状'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock Text="{loc:Loc '选「终端默认」表示不特别设置。'}" Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding CursorShapeOptions}"
                                            SelectedValue="{Binding SelectedCursorShapeId, Mode=TwoWay}"
                                            SelectedValuePath="Id" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '光标颜色'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock Text="{loc:Loc '填 #RGB 或 #RRGGBB；留空跟随系统配色。'}" Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <TextBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            Text="{Binding CursorColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{loc:Loc '例如 #FFFFFF；留空表示不设置'}" />
                                    </Grid>

                                    <!-- 背景图 -->
                                    <TextBlock Text="{loc:Loc '背景图'}" Style="{StaticResource AppearanceGroupTitleStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '背景图路径'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock Text="{loc:Loc '选一张本地图片；清空就取消背景图。'}" Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Grid.Column="0"
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Text="{Binding BackgroundImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{Binding BackgroundImage}" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Padding="8,3"
                                                Click="BrowseBackgroundImageButton_Click"
                                                Content="{loc:Loc '浏览…'}" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="6,0,0,0"
                                                Padding="8,3"
                                                Click="ClearBackgroundImageButton_Click"
                                                Content="{loc:Loc '清空'}"
                                                ToolTip="{loc:Loc '移除背景图设置'}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '背景图透明度'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock Text="{loc:Loc '数值越大，背景图越清晰。'}" Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <Slider
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                Maximum="100"
                                                Minimum="0"
                                                TickFrequency="1"
                                                Value="{Binding BackgroundImageOpacity, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                Text="{Binding BackgroundImageOpacityText}" />
                                        </Grid>
                                    </Grid>

                                    <!-- 窗口 -->
                                    <TextBlock Text="{loc:Loc '窗口'}" Style="{StaticResource AppearanceGroupTitleStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '窗口透明度'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock Text="{loc:Loc '100 是完全不透明，调低才能看出效果。'}" Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <Slider
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                Maximum="100"
                                                Minimum="0"
                                                TickFrequency="1"
                                                Value="{Binding WindowOpacity, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                Text="{Binding WindowOpacityText}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc '窗口透明亚克力材质'}" Style="{StaticResource SettingLabelStyle}" />
                                            <TextBlock Text="{loc:Loc '让透明背景带一点模糊，Windows 11 上效果最好。'}" Style="{StaticResource SettingHintStyle}" />
                                        </StackPanel>
                                        <CheckBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{loc:Loc '使用亚克力材质'}"
                                            IsChecked="{Binding UseAcrylic, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <!-- 统一操作：位于高级选项下方，两种方案共用。 -->
                        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                Appearance="Secondary"
                                Click="RestoreDefaultsButton_Click"
                                Content="{loc:Loc '恢复默认'}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                IsEnabled="{Binding CanRestoreDefaults}"
                                ToolTip="{loc:Loc '把当前方案恢复成程序默认，点「保存设置」后才写入。'}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="DiscardChangesButton_Click"
                                Content="{loc:Loc '放弃更改'}"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                IsEnabled="{Binding CanDiscardChanges}"
                                ToolTip="{loc:Loc '回到上次保存的状态，不写入文件。'}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Click="SaveSettingsButton_Click"
                                Content="{loc:Loc '保存设置'}"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                IsEnabled="{Binding CanSaveSettings}"
                                ToolTip="{loc:Loc '按当前方案写入提示符，并保存字体与外观改动。'}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 配置维护 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc '配置维护'}" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="starship.toml" Style="{StaticResource SettingLabelStyle}" />
                                <Border
                                    Padding="10,7"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TomlPath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding TomlPath}" />
                                </Border>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{loc:Loc '应用主题前会自动备份，点这里还原上次的配置。'}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{loc:Loc '第一次改终端设置时会备份原始配置，点这里可还原；备份不会被覆盖。'}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{Binding WtBackupText}" />
                                <TextBlock
                                    FontFamily="{StaticResource MonoFontFamily}"
                                    FontSize="11"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{Binding WtBackupPathText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding WtBackupPathText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="OpenTomlButton_Click"
                                    Content="{loc:Loc '打开 starship.toml'}"
                                    Icon="{ui:SymbolIcon DocumentText24}"
                                    IsEnabled="{Binding CanOpenToml}" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="RestoreTomlButton_Click"
                                    Content="{loc:Loc '恢复上次主题设置'}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsEnabled="{Binding CanRestoreToml}" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="RestoreWtBackupButton_Click"
                                    Content="{loc:Loc '恢复终端备份'}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsEnabled="{Binding CanRestoreWtBackup}"
                                    ToolTip="{loc:Loc '还原到第一次修改前的样子；备份会保留。'}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 反馈 -->
                <StackPanel Margin="0,6,0,16">
                    <TextBlock
                        FontSize="12"
                        Text="{Binding FeedbackMessage}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Saved">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Written">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
