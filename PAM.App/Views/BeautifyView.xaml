<UserControl
    x:Class="PAM.App.Views.BeautifyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    Loaded="View_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <ScrollViewer
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 页头 -->
                <StackPanel Margin="0,4,0,18">
                    <TextBlock Text="美化" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Text="为终端配置 Starship 提示符与 Nerd Font 字体；所有写入都会先自动备份。"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <!-- 终端字体（放在最前：Starship 官方建议先装好 Nerd Font） -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="终端字体" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="字体选择" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="{Binding CurrentFontText}"
                                    Style="{StaticResource SettingHintStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="写入 Windows Terminal 的 profiles.defaults.font.face；内置 Cascadia Code NF 已随本程序打包，未安装时可一键按当前用户安装。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ComboBox
                                    ItemsSource="{Binding FontOptions}"
                                    SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                    ToolTip="{Binding WtSettingsPath}" />
                                <!-- 两个按钮横排会超出 320 列宽，右对齐时左端会被裁掉；改成各占一行。 -->
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="InstallBundledFontButton_Click"
                                    Content="安装内置字体"
                                    Icon="{ui:SymbolIcon FontIncrease24}"
                                    IsEnabled="{Binding CanInstallBundledFont}"
                                    ToolTip="把打包的 Cascadia Code NF 安装为当前用户字体（免管理员权限）。" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Click="ApplyFontButton_Click"
                                    Content="应用到 Windows Terminal"
                                    Icon="{ui:SymbolIcon PaintBrush24}"
                                    IsEnabled="{Binding CanApplyFont}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock
                                    Text="想要其他 Nerd Font？安装 Scoop 后执行：scoop bucket add nerd-fonts，再安装如 JetBrains-Mono-NF、FiraCode-NF 等包，重启本页即可在下拉中看到。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Starship -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Starship" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        FontSize="14"
                                        Margin="0,0,6,0"
                                        Symbol="Rocket24"
                                        VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StarshipStatusText}" Style="{StaticResource SettingLabelStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:SymbolIcon
                                        FontSize="14"
                                        Margin="0,0,6,0"
                                        Symbol="Toolbox24"
                                        VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ScoopStatusText}" Style="{StaticResource SettingHintStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Text="Starship 是跨 shell 的提示符引擎；通过 Scoop 安装后自动可用，无需手动配置 PATH。"
                                    Style="{StaticResource SettingHintStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="Starship 官方建议先装好 Nerd Font：请在上方选择字体后再安装。"
                                    Visibility="{Binding HasFontSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="已安装，无需重复安装；换字体后重新打开终端即可生效。"
                                    Visibility="{Binding IsStarshipInstalled, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Click="OneClickInstallButton_Click"
                                    Content="一键安装（含 Scoop）"
                                    Icon="{ui:SymbolIcon Wand24}"
                                    IsEnabled="{Binding CanOneClickInstall}"
                                    ToolTip="未选字体或已安装时不可用。" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="RefreshButton_Click"
                                    Content="重新检测"
                                    Icon="{ui:SymbolIcon ArrowSync24}"
                                    IsEnabled="{Binding CanRefresh}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 主题 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="主题" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="主题预设" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="应用后写入 starship.toml，并确保 $PROFILE 里有 starship init 行；原配置会自动备份为 starship.toml.bak。"
                                    Style="{StaticResource SettingHintStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="标注“需 Nerd Font”的预设要先装好字体，否则提示符会出现乱码方块。" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <ComboBox
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding PresetOptions}"
                                    SelectedValue="{Binding SelectedPresetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Id" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Appearance="Primary"
                                    Click="ApplyPresetButton_Click"
                                    Content="应用主题"
                                    Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                    IsEnabled="{Binding CanApplyPreset}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 自定义提示符 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="自定义提示符" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Text="用户名、主机名、当前路径等是 Starship 读取到的值，不用手填：从下面的下拉里选一个变量插入即可；@ : ~ $ 这些固定符号也能插入，颜色单独选。整行格式可以直接编辑，应用时只替换 starship.toml 的顶层 format，其余配置原样保留。"
                            Style="{StaticResource SettingHintStyle}" />

                        <!-- 实时预览（深色底模拟终端） -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="12,10"
                            Background="#1E1E1E"
                            CornerRadius="6">
                            <ItemsControl Focusable="False" ItemsSource="{Binding PromptPreviewParts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="14"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="预览为示意值，实际文字由 Starship 按系统状态生成（切换目录时路径会跟着变）。"
                            Style="{StaticResource SettingHintStyle}" />

                        <!-- 一整行 format 编辑器 -->
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource SettingLabelStyle}"
                            Text="格式（一整行 Starship format）" />
                        <TextBox
                            x:Name="PromptFormatBox"
                            Padding="8,6"
                            AcceptsReturn="False"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="12"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding PromptFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Disabled" />

                        <!-- 变量下拉 + 插入 + 选中文字上色 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                PlaceholderText="搜索变量"
                                Text="{Binding VariableSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding FilteredVariableOptions}"
                                SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                                ToolTip="{Binding SelectedVariable.ToolTipText}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="InsertVariableButton_Click"
                                Content="插入变量" />
                            <ui:Button
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="ColorizeButton_Click"
                                Content="给选中文字上色" />
                        </Grid>

                        <!-- 当前颜色 + 固定符号 -->
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="当前颜色" />
                            <ComboBox
                                Width="160"
                                ItemsSource="{Binding ColorOptions}"
                                SelectedValue="{Binding CurrentColor, Mode=TwoWay}"
                                SelectedValuePath="Hex">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                RadiusX="3"
                                                RadiusY="3"
                                                Fill="{Binding Brush}" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Text="{Binding Hex}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="插入固定符号" />
                            <Button
                                MinWidth="34"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="SymbolButton_Click"
                                Content="@"
                                FontFamily="{StaticResource MonoFontFamily}"
                                Tag="@" />
                            <Button
                                MinWidth="34"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="SymbolButton_Click"
                                Content=":"
                                FontFamily="{StaticResource MonoFontFamily}"
                                Tag=":" />
                            <Button
                                MinWidth="34"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="SymbolButton_Click"
                                Content="~"
                                FontFamily="{StaticResource MonoFontFamily}"
                                Tag="~" />
                            <Button
                                MinWidth="34"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="SymbolButton_Click"
                                Content="$"
                                FontFamily="{StaticResource MonoFontFamily}"
                                Tag="$" />
                            <Button
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="SymbolButton_Click"
                                Content="空格"
                                Tag="__space__" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                Appearance="Secondary"
                                Click="ResetPromptButton_Click"
                                Content="重置为默认"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                IsEnabled="{Binding CanResetPrompt}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="RestorePromptButton_Click"
                                Content="恢复应用前配置"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                IsEnabled="{Binding CanRestorePrompt}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Click="ApplyPromptButton_Click"
                                Content="应用到 Starship"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                IsEnabled="{Binding CanApplyPrompt}" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SettingHintStyle}" Text="{Binding PromptStatusText}" />
                        <TextBlock
                            FontFamily="{StaticResource MonoFontFamily}"
                            Style="{StaticResource SettingHintStyle}"
                            Text="{Binding PromptConfigPath}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding PromptConfigPath}" />
                    </StackPanel>
                </Border>

                <!-- 配置维护 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="配置维护" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="starship.toml" Style="{StaticResource SettingLabelStyle}" />
                                <Border
                                    Padding="10,7"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TomlPath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding TomlPath}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding TomlStatusText}" Style="{StaticResource SettingHintStyle}" />
                                    <TextBlock Margin="12,0,0,0" Text="{Binding InitLineText}" Style="{StaticResource SettingHintStyle}" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        Text="starship.toml.bak 存在"
                                        Style="{StaticResource SettingHintStyle}"
                                        Visibility="{Binding HasTomlBackup, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="OpenTomlButton_Click"
                                    Content="打开 starship.toml"
                                    Icon="{ui:SymbolIcon DocumentText24}"
                                    IsEnabled="{Binding CanOpenToml}" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="RestoreTomlButton_Click"
                                    Content="恢复 starship.toml 备份"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsEnabled="{Binding CanRestoreToml}" />
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Secondary"
                                    Click="RestoreWtBackupButton_Click"
                                    Content="恢复 Windows Terminal 备份"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsEnabled="{Binding CanRestoreWtBackup}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 反馈 -->
                <StackPanel Margin="0,6,0,16">
                    <TextBlock
                        FontSize="12"
                        Text="{Binding FeedbackMessage}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Saved">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Written">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
