<UserControl
    x:Class="PAM.App.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    Loaded="View_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 与 SettingsView 保持一致的本地样式（非全局，需各自定义） -->
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 应用名片标题：与“关于”同为 SemiBold，但字号收敛到 18，配 48px 图标更协调 -->
        <Style x:Key="AppTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- 两行：上=可滚动内容，下=页脚（始终贴在页面最底端居中） -->
    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 页头（与其他页一致：标题 + PAM-About 标记） -->
                <Grid Margin="0,4,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="软件信息、帮助与开源支持入口。"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource PageTagBorderStyle}">
                        <TextBlock Text="PAM-About" Style="{StaticResource PageTagTextStyle}" />
                    </Border>
                </Grid>

                <!-- ============ 模块一：应用名片（头部） ============ -->
                <Border Style="{StaticResource CardStyle}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 左侧 48x48 应用图标（命中原生帧，零缩放，无锯齿） -->
                        <Image
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            Source="pack://application:,,,/PAM.App;component/Assets/App.ico" />
                        <!-- 右侧：标题（18px SemiBold，与“关于”同字重）+ 版本徽章 + 副标题 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="AppNameText" Style="{StaticResource AppTitleStyle}" />
                                <Border
                                    Margin="10,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        x:Name="VersionBadge"
                                        Text="v1.0.0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,9,0,0"
                                Text="一站式管理你的别名、命令与终端美化。"
                                Style="{StaticResource SettingHintStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 模块二：帮助与反馈 ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="帮助与支持" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Text="遇到问题或有建议？欢迎反馈。"
                                Style="{StaticResource SettingHintStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                Appearance="Secondary"
                                Click="HelpDocButton_Click"
                                Content="帮助文档" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Click="SubmitFeedbackButton_Click"
                                Content="提交反馈" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 模块三：开源与支持 ============ -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="开源与支持" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Text="本软件基于 MIT 协议开源。Copyright © 2024 你的名字。"
                                Style="{StaticResource SettingHintStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                Appearance="Secondary"
                                Click="RepoButton_Click"
                                Content="GitHub 仓库" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="LicenseButton_Click"
                                Content="查看许可证" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="SponsorButton_Click"
                                Content="☕ 赞助支持" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 页脚：最浅灰小字，居中，贴在页面最底端 -->
        <TextBlock
            Grid.Row="1"
            Margin="0,10,0,14"
            HorizontalAlignment="Center"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="本地运行 ・ 开源免费 ・ 不收集任何隐私数据" />
    </Grid>
</UserControl>
