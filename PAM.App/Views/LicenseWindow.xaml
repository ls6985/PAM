<ui:FluentWindow
    x:Class="PAM.App.Views.LicenseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:PAM.App"
    Title="查看许可证"
    Width="640"
    Height="520"
    MinWidth="520"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!-- 二级弹窗统一规范：与 InfoDialogWindow 同款外壳。
         许可证全文来自随程序内嵌的根目录 LICENSE，右侧「在 GitHub 上查看」打开原件。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="查看许可证"
            Icon="{ui:SymbolIcon DocumentText24}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,4,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="本软件基于 MIT 协议开源，可自由使用、修改与分发。"
                TextWrapping="Wrap" />
            <Border
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="16,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBox
                    x:Name="LicenseTextBox"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    IsTabStop="False"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <ui:Button
                HorizontalAlignment="Left"
                Appearance="Secondary"
                Click="ViewOnGitHubButton_Click"
                Content="在 GitHub 上查看" />
            <ui:Button
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="CloseButton_Click"
                Content="{loc:Loc Close}"
                IsCancel="True"
                IsDefault="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
