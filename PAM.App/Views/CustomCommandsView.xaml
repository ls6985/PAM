<UserControl
    x:Class="PAM.App.Views.CustomCommandsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PAM.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:PAM.Core.Models;assembly=PAM.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="900"
    PreviewKeyDown="View_PreviewKeyDown"
    mc:Ignorable="d">

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="自定义命令" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Text="把常用函数或脚本片段收进 $PROFILE 的受控区块，保存时只改写该区块，其余配置原样保留。"
                    Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Padding="12,8"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ToolTip="保存时只重写该区块，区块外的 $PROFILE 内容不会被修改。">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Code24"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontFamily="{StaticResource MonoFontFamily}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="#region PAM-Custom"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                x:Name="SearchBox"
                Width="380"
                HorizontalAlignment="Left"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="搜索名称、代码或备注"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button
                    x:Name="AddButton"
                    Click="AddButton_Click"
                    Content="新建命令"
                    Icon="{ui:SymbolIcon Add24}" />
                <ui:Button
                    x:Name="SaveButton"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Click="SaveButton_Click"
                    Content="保存并生效"
                    Icon="{ui:SymbolIcon Save24}"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- 内联编辑条 -->
        <Border
            x:Name="EditorPanel"
            Grid.Row="2"
            Margin="0,0,0,14"
            Padding="18"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="Code24"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding EditorTitle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="Ctrl+Enter 确定 · Esc 取消"
                        Style="{StaticResource TertiaryTextStyle}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="命令名称（必填）" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox
                            x:Name="NameField"
                            IsEnabled="{Binding IsNameFieldEnabled}"
                            PlaceholderText="例如 ll 或 Get-Project"
                            Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox
                            x:Name="RemarkField"
                            PlaceholderText="例如：列出当前目录并按时间排序"
                            Text="{Binding EditorRemark, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <TextBlock Text="状态" Style="{StaticResource FieldLabelStyle}" />
                        <CheckBox
                            x:Name="EnabledCheck"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            Content="启用该命令"
                            IsChecked="{Binding EditorEnabled}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="6"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Content="取消" />
                        <ui:Button
                            x:Name="ConfirmButton"
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Click="ConfirmButton_Click"
                            Content="确定"
                            Icon="{ui:SymbolIcon Checkmark24}"
                            IsEnabled="{Binding IsConfirmEnabled}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="命令代码（必填）" Style="{StaticResource FieldLabelStyle}" />
                    <Border
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4">
                        <TextBox
                            x:Name="CodeEditor"
                            MinHeight="120"
                            MaxHeight="220"
                            Padding="6,4"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="13"
                            HorizontalScrollBarVisibility="Auto"
                            SpellCheck.IsEnabled="False"
                            Text="{Binding EditorCode, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="代码会被原样写入受控区块；禁用的命令保存为注释行，重新启用后完整还原。"
                        Style="{StaticResource TertiaryTextStyle}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Text="{Binding EditorErrorText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding EditorErrorText, Converter={StaticResource TextNotEmptyToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- 列标题 -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,4"
            Padding="16,8"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称" Style="{StaticResource ColumnHeaderTextStyle}" />
                <TextBlock
                    Grid.Column="1"
                    Text="状态"
                    Style="{StaticResource ColumnHeaderTextStyle}" />
                <TextBlock
                    Grid.Column="2"
                    Text="代码预览"
                    Style="{StaticResource ColumnHeaderTextStyle}" />
                <TextBlock
                    Grid.Column="3"
                    Text="备注"
                    Style="{StaticResource ColumnHeaderTextStyle}" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Text="操作"
                    Style="{StaticResource ColumnHeaderTextStyle}" />
            </Grid>
        </Border>

        <!-- 命令列表：加载中隐藏，避免与空状态叠加重影 -->
        <Grid Grid.Row="4">
            <ui:ListView
                x:Name="CommandList"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource AliasListItemStyle}"
                ItemsSource="{Binding Commands}"
                MouseDoubleClick="CommandList_MouseDoubleClick"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Single"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ui:ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CustomCommandEntry}">
                        <Grid Height="52" Margin="16,0">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                Text="{Binding Name}"
                                ToolTip="{Binding Name}"
                                Style="{StaticResource AliasNameTextStyle}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:Button
                                    Padding="0"
                                    AutomationProperties.Name="切换启用状态"
                                    Click="ToggleStateButton_Click"
                                    ToolTip="点击启用 / 禁用">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource RowIconButtonStyle}" TargetType="{x:Type ui:Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltin}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <Border
                                        Padding="8,2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <TextBlock FontSize="11" Text="{Binding StateText}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </ui:Button>

                                <!-- 内置命令只读展示，用徽章代替启停开关。 -->
                                <Border
                                    Padding="8,2"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="10"
                                    ToolTip="内置命令，随保存自动维护，不可编辑或删除"
                                    Visibility="{Binding IsBuiltin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="内置" />
                                </Border>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,16,0"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding PreviewText}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding PreviewText}"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="3"
                                Margin="0,0,16,0"
                                Text="{Binding Remark}"
                                ToolTip="{Binding Remark}"
                                Style="{StaticResource RemarkTextStyle}" />

                            <Grid
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource RowActionPanelStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltin}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:Button
                                        AutomationProperties.Name="编辑"
                                        Click="EditButton_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="编辑">
                                        <ui:SymbolIcon FontSize="15" Symbol="Edit24" />
                                    </ui:Button>
                                    <ui:Button
                                        AutomationProperties.Name="删除"
                                        Margin="2,0,0,0"
                                        Click="DeleteButton_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="删除（再次点击确认）">
                                        <Grid>
                                            <ui:SymbolIcon
                                                FontSize="15"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Symbol="Delete24"
                                                Visibility="{Binding IsDeleteIdle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Text="确认删除？"
                                                Visibility="{Binding DeletePending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- 空状态：加载中隐藏，加载完成且列表为空时才显示 -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <StackPanel.Visibility>
                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}">
                        <Binding Path="IsLoading" />
                        <Binding Path="IsListEmpty" />
                    </MultiBinding>
                </StackPanel.Visibility>
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="38"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="Code24" />
                <TextBlock x:Name="EmptyTitleText" Style="{StaticResource EmptyTitleStyle}" />
                <TextBlock x:Name="EmptyDescriptionText" Style="{StaticResource EmptyDescriptionStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
