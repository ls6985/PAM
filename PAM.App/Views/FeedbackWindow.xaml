<ui:FluentWindow
    x:Class="PAM.App.Views.FeedbackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:PAM.App"
    Title="提交反馈"
    Width="560"
    Height="440"
    MinWidth="480"
    MinHeight="380"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!-- 二级弹窗统一规范：与 CommandGuideWindow「示例 / 指南」同款外壳。
         提交时打开 GitHub 新建 Issue 页并预填内容，同时复制到剪贴板；不自动发送、不上传、不落盘。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="提交反馈"
            Icon="{ui:SymbolIcon Chat24}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Margin="24,4,24,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="遇到问题或有改进建议？填好下面几项就行。"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="点击提交会打开 GitHub 的新建 Issue 页面，标题与正文已自动填好，确认发布即可；内容同时复制到剪贴板。"
                    TextWrapping="Wrap" />

                <!-- 反馈类型 -->
                <TextBlock Margin="0,20,0,6" Text="反馈类型" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="TypeBox" SelectedIndex="0">
                    <ComboBoxItem Content="问题反馈" />
                    <ComboBoxItem Content="功能建议" />
                    <ComboBoxItem Content="其他" />
                </ComboBox>

                <!-- 反馈内容 -->
                <TextBlock Margin="0,16,0,6" Text="反馈内容 *" Style="{StaticResource FieldLabelStyle}" />
                <Border
                    Padding="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBox
                        x:Name="ContentBox"
                        MinHeight="110"
                        MaxHeight="200"
                        Padding="6,4"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        SpellCheck.IsEnabled="False"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="写清现象与复现步骤会更容易定位问题；版本与系统信息会在提交时自动附上。" />

                <!-- 联系方式（选填） -->
                <TextBlock Margin="0,16,0,6" Text="联系方式（选填）" Style="{StaticResource FieldLabelStyle}" />
                <ui:TextBox
                    x:Name="ContactBox"
                    PlaceholderText="GitHub 账号或其他联系方式，方便回复你" />

                <!-- 校验提示 -->
                <TextBlock
                    x:Name="ValidationText"
                    Margin="0,10,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="请先填写反馈内容。"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Appearance="Secondary"
                    Click="CancelButton_Click"
                    Content="{loc:Loc Cancel}"
                    IsCancel="True" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Click="SubmitButton_Click"
                    Content="提交反馈"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
