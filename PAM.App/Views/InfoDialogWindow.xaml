<ui:FluentWindow
    x:Class="PAM.App.Views.InfoDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:PAM.App"
    Width="640"
    Height="400"
    MinWidth="520"
    MinHeight="300"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!--
        二级弹窗统一规范（与 CommandGuideWindow「示例 / 指南」同款）：
        FluentWindow + Mica + 自定义 TitleBar（无最小化/最大化）+ 24 边距可滚动内容区
        + 右下角 Primary「关闭」按钮。以后新增二级弹窗请以本窗口为模板，
        避免再次出现系统 MessageBox 那种风格割裂。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="DialogTitleBar"
            Grid.Row="0"
            Title="提示"
            Icon="{ui:SymbolIcon Info24}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Margin="24,4,24,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 主说明：与指南 intro 同款 13px 次要色 -->
                <TextBlock
                    x:Name="MessageText"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <!-- 次要提示：与指南 hint 同款 12px 三级色，按需显示 -->
                <TextBlock
                    x:Name="HintText"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <ui:Button
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="CloseButton_Click"
                Content="{loc:Loc Close}"
                IsCancel="True"
                IsDefault="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
