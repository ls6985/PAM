<UserControl
    x:Class="PAM.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    Loaded="View_Loaded"
    Unloaded="View_Unloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <ScrollViewer
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 页头 -->
                <Grid Margin="0,4,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="设置" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="调整外观、终端与全局热键。修改会立即保存，并同步到后台托盘。"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource PageTagBorderStyle}"
                        ToolTip="保存时只重写该区块，区块外的 $PROFILE 内容不会被修改。">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                FontSize="16"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Code24"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Style="{StaticResource PageTagTextStyle}"
                                Text="PAM-Settings" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 外观 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="主题" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="PAM 界面的明暗风格。" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding ThemeOptions}"
                                SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Id" />

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="语言" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="界面显示语言，切换后立即生效。" Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding LanguageOptions}"
                                SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Id" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 终端 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="终端" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="默认终端" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="用于全局热键唤醒的终端、保存后启动的窗口，以及下方“打开配置文件”。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding TerminalOptions}"
                                SelectedValue="{Binding TerminalType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Id" />

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="打开配置文件" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="按上方选择的默认终端打开对应的 $PROFILE；文件不存在时会自动创建。"
                                    Style="{StaticResource SettingHintStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{Binding TerminalHint}"
                                    Visibility="{Binding TerminalHint, Converter={StaticResource TextNotEmptyToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <Border
                                    Padding="10,7"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ProfilePathDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ProfilePathDisplay}" />
                                </Border>
                                <ui:Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Appearance="Secondary"
                                    Click="OpenProfileButton_Click"
                                    Content="打开配置文件"
                                    Icon="{ui:SymbolIcon DocumentText24}"
                                    IsEnabled="{Binding CanOpenProfile}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 全局热键 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="全局热键" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="打开终端" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock Text="点击“更改”后按下组合键；Esc 取消录制。" Style="{StaticResource SettingHintStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource SettingHintStyle}"
                                    Text="{Binding CapturePrompt}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border
                                    x:Name="HotkeyCaptureBox"
                                    Padding="10,8"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Focusable="True"
                                    MouseLeftButtonDown="HotkeyCaptureBox_MouseLeftButtonDown"
                                    PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="HotkeyDisplayText"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding HotkeyDisplay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="13"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding PendingHotkeyDisplay}"
                                            Visibility="{Binding HasPendingHotkey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <!-- 四个按钮横排会超出 320 列宽、最后一个被裁掉；改成 2×2 等宽。 -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ui:Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="ChangeHotkeyButton_Click"
                                        Content="更改…"
                                        Icon="{ui:SymbolIcon Keyboard24}" />
                                    <ui:Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Click="RestoreHotkeyButton_Click"
                                        Content="恢复默认" />
                                    <ui:Button
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Appearance="Secondary"
                                        Click="CheckHotkeyButton_Click"
                                        Content="检测冲突"
                                        IsEnabled="{Binding CanCheckHotkey}" />
                                    <ui:Button
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Appearance="Primary"
                                        Click="ApplyHotkeyButton_Click"
                                        Content="应用热键"
                                        IsEnabled="{Binding CanApplyHotkey}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 冲突检测结果 -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="12,10"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    FontSize="17"
                                    Symbol="Info24"
                                    VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotkeyStatusKind}" Value="Ok">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HotkeyStatusKind}" Value="Warning">
                                                    <Setter Property="Symbol" Value="Warning24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HotkeyStatusKind}" Value="Error">
                                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding HotkeyStatusMessage}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotkeyStatusKind}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HotkeyStatusKind}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HotkeyStatusKind}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 终端输入 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="终端输入" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="打开终端时把中文输入法切到英文模式" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="后台托盘检测到新打开的 PowerShell / Windows Terminal 窗口时，先读任务栏输入指示器；只有处于中文模式才模拟一次 Shift 切到英文输入状态。输入法本身不变，也不会换成英文键盘；已是英文模式时一个键都不按。每个窗口只处理一次。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding SwitchImeToEnglish, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 别名启动 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="别名启动" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="独立进程启动（静默日志）" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="用别名启动软件时改为独立进程，并把子进程的 stdout/stderr 重定向到 NUL 设备：终端不再刷程序日志，关闭 PowerShell 也不会把软件一起关掉。关闭则恢复原来的直接启动方式。$PROFILE 只在终端启动时加载一次，保存别名后要新开终端窗口才生效。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding AliasLaunchEnhanced, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启动时显示别名备注" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="启动前在终端打印一行该别名的备注；没有备注时不打印。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding ShowAliasRemarkOnLaunch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="未找到命令时显示友好提示" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="终端里输入不存在的命令时，用一行简短提示代替 PowerShell 的红色报错，并引导到 pls 或管理器。关闭后恢复默认报错；$PROFILE 只在终端启动时加载，保存后要新开终端窗口才生效。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding FriendlyCommandNotFound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 后台运行 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="后台运行" Style="{StaticResource CardTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动后台托盘" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="登录 Windows 后自动启动托盘并注册全局热键，无需先打开管理器。移动程序目录后打开一次管理器即可更新启动项路径。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding StartTrayWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="关闭管理器时保留后台托盘" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Text="关闭后台托盘后，全局热键立即失效（无法用快捷键唤起终端），托盘菜单也会消失；下次打开管理器或点“立即启动”才会恢复。"
                                    Style="{StaticResource SettingHintStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                IsChecked="{Binding KeepTrayOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="后台托盘状态" Style="{StaticResource SettingLabelStyle}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding TrayStatusText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Secondary"
                                    Click="StartTrayButton_Click"
                                    Content="立即启动"
                                    Icon="{ui:SymbolIcon Play24}"
                                    Visibility="{Binding IsTrayRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <ui:Button
                                    Appearance="Secondary"
                                    Click="StopTrayButton_Click"
                                    Content="结束后台运行"
                                    Icon="{ui:SymbolIcon Dismiss24}"
                                    Visibility="{Binding IsTrayRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 底部：设置文件与反馈 -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="设置文件" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding SettingsFilePath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SettingsFilePath}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12"
                                Text="{Binding FeedbackMessage}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FeedbackKind}" Value="Saved">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeedbackKind}" Value="Written">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeedbackKind}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeedbackKind}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            Click="RestoreDefaultsButton_Click"
                            Content="恢复默认设置"
                            Icon="{ui:SymbolIcon ArrowReset24}" />
                    </Grid>
                </Border>

                <TextBlock
                    Margin="0,0,0,8"
                    Text="所有更改都会立即写入 settings.json。"
                    Style="{StaticResource TertiaryTextStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
