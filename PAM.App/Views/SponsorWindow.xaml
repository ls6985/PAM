<ui:FluentWindow
    x:Class="PAM.App.Views.SponsorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:PAM.App"
    Title="赞助支持"
    Width="520"
    Height="500"
    MinWidth="460"
    MinHeight="440"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!-- 二级弹窗统一规范：与 CommandGuideWindow「示例 / 指南」同款外壳。
         内容布局：标题 + 一句话 → 两张并排收款码 → 一句收尾 → 关闭。
         收款码图片在 Assets/Sponsor/ 下，替换同名 PNG 即可换码。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="赞助支持"
            Icon="{ui:SymbolIcon Heart24}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Margin="24,4,24,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 主标题 + 一句话：短、对比度高，不做大段灰字 -->
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="支持 PowerShell 管理器" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="如果它帮你省下了敲命令的时间，可以扫码请我喝杯咖啡。"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="开源免费 ・ 完全自愿 ・ 不影响任何功能" />

                <!-- 两张收款码并排：白底是硬要求，保证任何主题下都能扫 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <Border
                                Width="140"
                                Height="140"
                                Padding="6"
                                HorizontalAlignment="Center"
                                Background="White"
                                CornerRadius="8">
                                <Image
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="pack://application:,,,/PAM.App;component/Assets/Sponsor/WeChatPay.png"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="微信支付" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <Border
                                Width="140"
                                Height="140"
                                Padding="6"
                                HorizontalAlignment="Center"
                                Background="White"
                                CornerRadius="8">
                                <Image
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    SnapsToDevicePixels="True"
                                    Source="pack://application:,,,/PAM.App;component/Assets/Sponsor/AliPay.png"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="支付宝" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Margin="0,16,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="金额由你决定。无论是否支持，都会继续认真维护。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <ui:Button
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="CloseButton_Click"
                Content="{loc:Loc Close}"
                IsCancel="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
