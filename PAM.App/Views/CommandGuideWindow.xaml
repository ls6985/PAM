<ui:FluentWindow
    x:Class="PAM.App.Views.CommandGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="示例 / 指南"
    Width="720"
    Height="640"
    MinWidth="560"
    MinHeight="460"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="示例 / 指南"
            Icon="{ui:SymbolIcon BookQuestionMark24}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Margin="24,4,24,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="把下面的命令复制后，点「新建命令」，粘贴到命令代码里，设置好命令名称，保存并生效即可。"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="命令名称就是将来在终端里输入的名字；代码只写要执行的命令，不需要写 function。"
                    TextWrapping="Wrap" />

                <!-- 示例列表：每条给出功能说明、建议别名与可直接复制的代码（支持多行）。 -->
                <ItemsControl x:Name="ExampleList" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,10"
                                Padding="14,12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Description}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding AliasHint}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBox
                                            Margin="0,6,0,0"
                                            Padding="8,6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderThickness="0"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            IsReadOnly="True"
                                            Text="{Binding Code, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Appearance="Secondary"
                                        Click="CopyExampleButton_Click"
                                        Content="复制"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,12,24,20">
            <TextBlock
                x:Name="CopyStatusText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            <ui:Button
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="CloseButton_Click"
                Content="关闭"
                IsCancel="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
