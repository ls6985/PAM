<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PAM.App</RootNamespace>
    <AssemblyName>PAM.App</AssemblyName>
    <!-- 显示名称与 exe 文件名分离：exe 仍叫 PAM.App.exe（托盘按该文件名拉起），资源管理器/文件属性里显示为“PowerShell 管理器”。 -->
    <AssemblyTitle>PowerShell 管理器</AssemblyTitle>
    <Product>PowerShell 管理器</Product>
    <Version>1.0.0</Version>
    <Description>在图形界面中管理 Windows PowerShell $PROFILE 里的 Set-Alias 快捷启动项。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- 内置 Cascadia Code NF（变量字体，美化页可一键按当前用户安装）。 -->
  <ItemGroup>
    <Content Include="Assets\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PAM.Core\PAM.Core.csproj" />
  </ItemGroup>

  <!--
    两个程序在运行时互相按 AppContext.BaseDirectory 找对方：主界面靠 EnsureTrayRunning() 拉起
    PAM.Tray.exe，托盘右键“显示主界面”靠 PAM.App.exe。所以各自的输出目录里必须是完整可跑的一对，
    和本机安装/发布到同一目录的形态一致。
    不能用 ProjectReference 互指（还原图成环，MSB4006），因此构建结束后各自把产物推给对方目录；
    PAM.Core.* 两边都会自己生成、对方的产物也不该回推，都排除掉。
  -->
  <Target Name="PushAppOutputToTray" AfterTargets="Build">
    <PropertyGroup>
      <_TrayOutputDir>$(MSBuildThisFileDirectory)..\PAM.Tray\bin\$(Configuration)\$(TargetFramework)\</_TrayOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_AppSelfOutput Include="$(OutDir)**\*.*" Exclude="$(OutDir)PAM.Core.*;$(OutDir)PAM.Tray.*" />
    </ItemGroup>
    <MakeDir Directories="$(_TrayOutputDir)" />
    <Copy SourceFiles="@(_AppSelfOutput)"
          DestinationFiles="@(_AppSelfOutput->'$(_TrayOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
