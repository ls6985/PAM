<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PAM.Core</RootNamespace>
    <AssemblyName>PAM.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Description>数据模型、$PROFILE 读写与终端启动服务。</Description>
  </PropertyGroup>

  <!-- Starship 内置主题预设（StarshipService 按 PAM.Core.Presets.<id>.toml 解出）。 -->
  <ItemGroup>
    <EmbeddedResource Include="Presets\*.toml" />
  </ItemGroup>

  <!-- JSONC 解析（Windows Terminal settings.json 的精准拼接）。 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 单元测试需要覆盖 internal 纯逻辑（ProfileDocument / SpliceFontFace 等）。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="PAM.Tests" />
  </ItemGroup>

</Project>
