<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 只为拿到 WindowsDesktop 引用集里的 UIAutomationClient / UIAutomationTypes：
         读任务栏输入指示器要用 UIA，运行时与 WinForms 共用 Microsoft.WindowsDesktop.App。
         WinForms 项目默认不含这两个引用，而 UIA 归在 WPF 引用集里。 -->
    <UseWPF>true</UseWPF>
    <RootNamespace>PAM.Tray</RootNamespace>
    <AssemblyName>PAM.Tray</AssemblyName>
    <!-- 显示名称与 exe 文件名分离：exe 仍叫 PAM.Tray.exe（单实例、互斥体等按进程名工作），资源管理器/文件属性里显示为“PowerShell 管理器”。 -->
    <AssemblyTitle>PowerShell 管理器</AssemblyTitle>
    <Product>PowerShell 管理器</Product>
    <Version>1.0.0</Version>
    <Description>系统托盘入口（全局热键与终端唤醒）。</Description>
    <!-- exe 图标复用主界面那份 ico，资源管理器/任务管理器里两者显示一致；只是资源文件，不构成对 PAM.App 的项目引用。 -->
    <ApplicationIcon>..\PAM.App\Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PAM.Core\PAM.Core.csproj" />
    <!-- UseWPF 会换一套隐式 global using，这里显式补回 System.IO。 -->
    <Using Include="System.IO" />
  </ItemGroup>

  <!--
    与 PAM.App.csproj 的 PushAppOutputToTray 对称：把本程序产物推给主界面的输出目录，
    保证 clean 重建后任意一个 bin 里仍是完整可跑的一对（EnsureTrayRunning / 显示主界面 都靠同目录找对方）。
    PAM.Core.* 两边各自生成、PAM.App.* 属于对方产物，都不回推。
  -->
  <Target Name="PushTrayOutputToApp" AfterTargets="Build" Condition="'$(PamSkipOutputPush)' != 'true'">
    <PropertyGroup>
      <_AppOutputDir>$(MSBuildThisFileDirectory)..\PAM.App\bin\$(Configuration)\$(TargetFramework)\</_AppOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_TraySelfOutput Include="$(OutDir)**\*.*" Exclude="$(OutDir)PAM.Core.*;$(OutDir)PAM.App.*" />
    </ItemGroup>
    <MakeDir Directories="$(_AppOutputDir)" />
    <Copy SourceFiles="@(_TraySelfOutput)"
          DestinationFiles="@(_TraySelfOutput->'$(_AppOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
